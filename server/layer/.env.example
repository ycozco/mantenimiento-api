NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DATABASE_URL=postgresql://decolumax:change-me@localhost:5432/decolumax
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-another-long-random-secret
PDF_STORAGE_PATH=./var/pdfs
RUN_MIGRATIONS=false
DATABASE_POOL_MAX=10
# These credentials stay on the API container; never add them to Flutter.
NATS_URL=tls://mant.qpsecure.cloud:4422
NATS_SYNC_USER=decolumax_runtime
NATS_SYNC_PASSWORD=replace-with-runtime-credential
NATS_SYNC_STREAM=DECO_SYNC
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
# Solo para scripts/bootstrap-admin.ts; nunca se expone al cliente.
WORKSPACE_SLUG=decolumax
WORKSPACE_NAME=Decolumax
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrador
ADMIN_PASSWORD=replace-with-at-least-12-characters
