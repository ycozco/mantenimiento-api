# Copy to .env.production on the VPS and replace every secret.
POSTGRES_DB=decolumax
POSTGRES_USER=decolumax
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_DAYS=30
RUN_MIGRATIONS=true

# Optional. If omitted, compose builds the image locally with the repository Dockerfile.
# SYNC_API_IMAGE=decolumax-sync-api:0.1.0
